{
  "manifest_version": 3,
  "name": "Anti-Spoil VI",
  "version": "1.2.0",
  "description": "Masque tout ce qui parle de GTA VI sur YouTube, X, Reddit, Discord web, TikTok, Twitch et le reste du web.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://i.ytimg.com/*",
    "https://i9.ytimg.com/*",
    "https://pbs.twimg.com/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://external-preview.redd.it/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://static-cdn.jtvnw.net/*",
    "https://*.cdninstagram.com/*",
    "https://media.discordapp.net/*",
    "https://cdn.discordapp.com/*",
    "https://encrypted-tbn0.gstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "keywords.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Anti-Spoil VI"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anti-spoil-vi@local",
      "strict_min_version": "121.0"
    }
  }
}
